# --- Gemini ---
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Required. Never commit a real key - this file is a template only.
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_TPM_LIMIT=4000000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=10

# --- HTTP transport ---
PORT=3000
HOST=127.0.0.1
# Bearer token required by /mcp. Mandatory when HOST is not a loopback address.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Extra allowed Host header hostnames (comma-separated, port-agnostic).
# Use * to disable host validation (only behind a trusted proxy).
# MCP_ALLOWED_HOSTS=mcp.internal,*.svc.cluster.local
# Exact Origin values allowed to call /mcp from a browser (comma-separated).
# Without this, any request carrying an Origin header is rejected.
# MCP_ALLOWED_ORIGINS=http://localhost:5173
# Explicitly allow an unauthenticated server on a public interface (NOT recommended).
# MCP_ALLOW_INSECURE_HTTP=1
# Concurrent MCP sessions allowed per process; further sessions get HTTP 429.
# MCP_MAX_SESSIONS=100
# Idle session lifetime in seconds; 0 keeps sessions until the client closes them.
# MCP_SESSION_TTL_SECONDS=1800

# --- Resource limits ---
# Max bytes accepted per local file / per fetched URL (default 64 MiB each).
# MCP_MAX_FILE_BYTES=67108864
# MCP_MAX_URL_BYTES=67108864
# Allow URL tools to reach loopback/private/link-local addresses (SSRF surface).
# MCP_ALLOW_PRIVATE_URLS=1
