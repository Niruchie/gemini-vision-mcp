{
  "name": "gemini-vision-mcp",
  "version": "0.1.0",
  "description": "Gemini Vision MCP - Describe video, image, audio and text using the Gemini Live API.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "gemini-vision-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "cross-env LIVE_TEST=1 vitest run tests/live.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.15.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
